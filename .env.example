# Rango de alerta (obligatorio)
MIN_PRICE=1000
MAX_PRICE=1500

# Cron (opcional)
CRON_SCHEDULE=*/5 * * * *
CRON_TZ=America/Argentina/Buenos_Aires

# Telegram (opcional; sin esto no se envían alertas)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Probar Telegram: GET http://localhost:3000/telegram/test

# Servidor (opcional)
PORT=3000
